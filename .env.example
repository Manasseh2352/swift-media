# --- Admin login -----------------------------------------------------
# The single admin account is defined entirely by these two variables —
# there's no user table. Generate the hash with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=admin

# Signs the admin session cookie. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# --- Storage -----------------------------------------------------------
# Create a Blob store in your Vercel project's Storage tab, then copy the
# token it gives you (Vercel also injects this automatically for projects
# deployed on Vercel with a Blob store attached — you only need to set it
# by hand for local development).
BLOB_READ_WRITE_TOKEN=
